    "code": "def p = { String k -> binding.hasVariable(k) ? binding.getVariable(k) : null }\ndef cond = [:]\ndef ff = p('filter_field')?.toString()?.trim()\ndef fv = p('filter_value')?.toString()?.trim()\nif (ff && fv) { cond = [operator:'AND', filters:[[property:'properties.' + ff, filter:[operator:'EQUAL', value: fv]]]] }\ndef lim = 60\ntry { def l = p('limit')?.toString()?.trim(); if (l) { lim = Integer.parseInt(l) } } catch (e) { lim = 60 }\nif (lim > 300) { lim = 300 }\nif (lim < 1) { lim = 1 }\ndef sorts = []\ndef sf = p('sort_field')?.toString()?.trim()\nif (sf) { sorts << [field:'properties.' + sf, order: (p('sort_order')?.toString()?.toUpperCase() == 'ASC' ? 'ASC' : 'DESC')] }\nreturn [cond: cond, page: [paginateBy:'OFFSET', limit: lim, offset: 0], sorts: sorts]",
